<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="{{ settings.color_ink }}">
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 64 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'ourcoordinates-logo-mark.svg' | asset_url }}">
  {%- endif -%}

  {%- liquid
    assign seo_title = page_title
    assign seo_description = page_description
    assign seo_canonical = canonical_url
    assign seo_type = 'website'
    assign seo_noindex = false

    if request.page_type == 'product'
      assign seo_type = 'product'
    elsif request.page_type == 'article'
      assign seo_type = 'article'
    endif

    if request.page_type == 'index'
      assign seo_description = 'Personalize coordinates jewelry with the place that matters most. Preview your engraving, receive a photo proof, and enjoy free US shipping.'
    elsif request.page_type == 'article'
      if seo_title == blank
        assign seo_title = article.title
      endif
      if seo_description == blank
        assign seo_description = article.excerpt_or_content | strip_html | strip_newlines
      else
        assign seo_description = seo_description | strip_html | strip_newlines
      endif
      assign seo_description_length = seo_description | size
      if seo_description_length > 165
        assign seo_description = seo_description | truncate: 155
      endif
    elsif request.page_type == 'collection' and collection.handle == 'all'
      assign seo_title = 'Personalized Coordinates Jewelry & Gifts | OurCoordinates'
      if seo_description == blank
        assign seo_description = 'Shop engraved coordinates jewelry, matching sets, bracelets, rings, and keepsakes personalized with a place or message that matters.'
      endif
    elsif request.page_type == 'collection' and collection.handle == 'coordinates-sets' and seo_description == blank
      assign seo_description = 'Shop matching coordinates jewelry sets engraved with one meaningful place, including necklaces, bracelets, rings, and keepsakes made to share.'
    elsif request.page_type == 'collection' and collection.handle == 'in-stock' and seo_description == blank
      assign seo_description = 'Browse personalized coordinates jewelry currently available to order, with engraving, clear delivery estimates, and a photo proof before shipping.'
    elsif request.page_type == 'blog' and blog.handle == 'ourcoordinates-journal' and seo_description == blank
      assign seo_description = 'Explore coordinates jewelry gift ideas, meaningful place stories, engraving guidance, and practical inspiration for anniversaries, travel, and milestones.'
    elsif request.page_type == 'page' and page.handle == 'gift-finder'
      assign seo_title = 'Coordinates Jewelry Gift Finder | OurCoordinates'
      assign seo_description = 'Find an in-stock personalized coordinates gift by recipient, story, and budget in about a minute.'
    elsif request.page_type == 'page' and page.handle == 'reviews'
      assign seo_title = 'Customer Reviews | OurCoordinates'
      assign seo_description = 'Read product feedback published through the OurCoordinates review partner and browse reviews by personalized jewelry piece.'
    elsif request.page_type == 'page' and page.handle == 'about-us'
      assign seo_title = 'About OurCoordinates | Family-Owned Coordinates Jewelry'
      assign seo_description = 'Meet the family behind OurCoordinates, an online jewelry business inspired by Santorini and built during COVID to turn meaningful places into personal keepsakes.'
    elsif request.page_type == 'page' and page.handle == 'shipping'
      assign seo_title = 'Shipping & Delivery | OurCoordinates'
      assign seo_description = 'Review OurCoordinates shipping options, production timing, delivery estimates, tracking details, and costs for personalized jewelry orders.'
    elsif request.page_type == 'page' and page.handle == 'jewelry-cleaning-care-guide'
      assign seo_title = 'Jewelry Cleaning & Care Guide | OurCoordinates'
      assign seo_description = 'Learn how to clean, store, and care for personalized jewelry so necklaces, bracelets, and rings stay bright and ready to wear.'
    elsif request.page_type == 'page' and page.handle == 'about-michael-heckert-founder-creator'
      assign seo_title = 'Michael Heckert, Founder of OurCoordinates'
      assign seo_description = 'Meet Michael Heckert, founder of OurCoordinates, and learn how meaningful places inspired a personalized coordinates jewelry business.'
    elsif request.page_type == 'page' and page.handle == 'gdpr-compliance'
      assign seo_title = 'GDPR Privacy Rights | OurCoordinates'
      assign seo_description = 'Manage GDPR privacy rights and request access, correction, deletion, or restriction of personal data processed by OurCoordinates.'
      assign seo_noindex = true
    elsif request.page_type == 'page' and page.handle == 'appi-compliance'
      assign seo_title = 'APPI Privacy Rights | OurCoordinates'
      assign seo_description = 'Manage APPI privacy rights and request access, correction, deletion, or other handling of personal data processed by OurCoordinates.'
      assign seo_noindex = true
    elsif request.page_type == 'page' and page.handle == 'ccpa-compliance'
      assign seo_title = 'California Privacy Rights | OurCoordinates'
      assign seo_description = 'Manage California privacy rights and request access, correction, deletion, or information about personal data handled by OurCoordinates.'
      assign seo_noindex = true
    elsif request.page_type == 'page' and page.handle == 'ccpa-opt-out'
      assign seo_title = 'Opt Out of Data Sale or Sharing | OurCoordinates'
      assign seo_description = 'Submit a request to opt out of the sale or sharing of personal information associated with your OurCoordinates activity.'
      assign seo_noindex = true
    elsif request.page_type == 'page' and page.handle == 'build-yours'
      assign seo_canonical = shop.url | append: '/pages/builder'
      assign seo_noindex = true
      assign seo_description = 'Use the OurCoordinates jewelry builder to choose a piece, enter a meaningful place, and prepare a personalized engraving.'
    elsif request.page_type == 'page' and page.handle == 'builder' and seo_description == blank
      assign seo_description = 'Build personalized coordinates jewelry step by step: choose a piece, enter a meaningful place, preview the engraving, and make it yours.'
    elsif request.page_type == 'page' and page.handle == 'christmas' and seo_description == blank
      assign seo_description = 'Create personalized coordinates jewelry for Christmas with a meaningful place, custom engraving, and a photo proof before your gift ships.'
    elsif request.page_type == 'page' and page.handle == 'how-it-works' and seo_description == blank
      assign seo_description = 'See how OurCoordinates turns a meaningful place into personalized jewelry, from finding coordinates and previewing engraving to photo proof and shipping.'
    elsif request.page_type == 'page' and page.handle == 'memory-map' and seo_description == blank
      assign seo_description = 'Save meaningful places in a personal memory map, then turn a favorite location into custom coordinates jewelry engraved just for you.'
    elsif request.page_type == 'page' and page.handle == 'ring-size-chart' and seo_description == blank
      assign seo_description = 'Use the OurCoordinates ring size chart and measuring guidance to choose a comfortable fit before ordering your personalized ring.'
    elsif request.page_type == 'collection' and collection.handle == 'forever-bracelets'
      assign seo_description = 'Shop forever bracelets that celebrate lasting love and friendship, including personalized and symbolic styles made for meaningful everyday wear.'
    elsif request.page_type == 'collection' and collection.handle == 'mens'
      assign seo_description = "Shop men's rings, bracelets, necklaces, and personalized jewelry in durable styles designed for meaningful gifts and everyday wear."
    elsif request.page_type == 'collection' and collection.handle == 'gold-jewelry'
      assign seo_description = 'Shop gold-plated necklaces, bracelets, rings, and personalized jewelry designed to add meaningful detail to everyday and occasion looks.'
    elsif request.page_type == 'collection' and collection.handle == 'shop-couples-necklaces'
      assign seo_description = 'Shop couples necklaces, matching pendants, and personalized designs made to celebrate shared stories, meaningful places, and lasting connection.'
    elsif request.page_type == 'collection' and collection.handle == 'mens-rings'
      assign seo_description = "Shop men's rings in stainless steel, silver, gold-tone, and statement styles, with personalized options for meaningful gifts."
    elsif request.page_type == 'collection' and collection.handle == 'fathers-day-gifts'
      assign seo_description = "Shop Father's Day jewelry for Dad, including personalized coordinates pieces, engraved keepsakes, bracelets, rings, and necklaces."
    elsif request.page_type == 'collection' and collection.handle == 'coordinates-bracelets'
      assign seo_description = 'Shop personalized coordinates bracelets engraved with a meaningful location, from classic cuffs to leather and chain-link styles.'
    endif

    assign social_image_url = blank
    assign social_image_alt = page_title
    if page_image
      assign social_image_url = page_image | image_url: width: 1200
      assign social_image_alt = page_image.alt | default: page_title
    elsif request.page_type == 'index'
      assign social_image_url = 'hero-necklace.jpg' | asset_url
      assign social_image_alt = 'Gold bar necklace engraved with coordinates on cream linen'
    endif
    if social_image_url != blank
      assign social_image_prefix = social_image_url | slice: 0, 2
      if social_image_prefix == '//'
        assign social_image_url = social_image_url | prepend: 'https:'
      else
        unless social_image_url contains 'http'
          assign social_image_url = shop.url | append: social_image_url
        endunless
      endif
    endif
  -%}

  <link rel="canonical" href="{{ seo_canonical }}">
  {%- if seo_noindex -%}<meta name="robots" content="noindex,follow">{%- endif -%}

  <title>
    {{ seo_title }}
    {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
    {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
    {%- unless request.page_type == 'product' or request.page_type == 'article' -%}
      {%- unless seo_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    {%- endunless -%}
  </title>

  {% if seo_description %}
    <meta name="description" content="{{ seo_description | escape }}">
  {% endif %}

  <meta property="og:site_name" content="{{ shop.name | escape }}">
  <meta property="og:title" content="{{ seo_title | escape }}">
  <meta property="og:url" content="{{ seo_canonical }}">
  <meta property="og:type" content="{{ seo_type }}">
  {%- if seo_description -%}<meta property="og:description" content="{{ seo_description | escape }}">{%- endif -%}
  {%- if social_image_url != blank -%}
    <meta property="og:image" content="{{ social_image_url }}">
    <meta property="og:image:alt" content="{{ social_image_alt | escape }}">
  {%- endif -%}

  <meta name="twitter:card" content="{% if social_image_url != blank %}summary_large_image{% else %}summary{% endif %}">
  <meta name="twitter:title" content="{{ seo_title | escape }}">
  {%- if seo_description -%}<meta name="twitter:description" content="{{ seo_description | escape }}">{%- endif -%}
  {%- if social_image_url != blank -%}<meta name="twitter:image" content="{{ social_image_url }}">{%- endif -%}

  {%- comment -%}
    PERFORMANCE STRATEGY (target: 90+ PageSpeed)
    1. Critical CSS inlined below - zero render-blocking stylesheets.
    2. Full stylesheet loaded async via preload swap.
    3. Fonts: Fraunces + Inter + IBM Plex Mono + Instrument Serif (Atelier display),
       display=swap, loaded async. System fonts paint first; brand fonts swap in.
    4. Sitewide JS is one small deferred file; product-only tools load only where needed.
  {%- endcomment -%}

  {% style %}
    :root {
      --c-ink: {{ settings.color_ink }};
      --c-paper: {{ settings.color_paper }};
      --c-gold: {{ settings.color_gold }};
      --c-gold-text: #6f522f;
      --c-graphite: {{ settings.color_graphite }};
      --c-line: {{ settings.color_ink | color_modify: 'alpha', 0.12 }};
      --c-ink-soft: {{ settings.color_ink | color_modify: 'alpha', 0.64 }};
      --f-display: 'Fraunces', Georgia, 'Times New Roman', serif;
      --f-body: 'Inter', -apple-system, 'Segoe UI', sans-serif;
      --f-coord: 'IBM Plex Mono', 'SF Mono', Consolas, monospace;
      --page-max: 1200px;
      --gutter: clamp(16px, 4vw, 40px);
    }
  {% endstyle %}

  <style>{% render 'critical-css' %}</style>

  <link rel="preload" href="{{ 'base.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>{{ 'base.css' | asset_url | stylesheet_tag }}</noscript>
  <link rel="preload" href="{{ 'ep.css' | asset_url }}" as="style" onload="this.onload=null;this.rel='stylesheet'">
  <noscript>{{ 'ep.css' | asset_url | stylesheet_tag }}</noscript>
  {{ 'site-optimizations.css' | asset_url | stylesheet_tag: preload: true }}
  {%- if request.page_type == 'article' -%}
    {{ 'article.css' | asset_url | stylesheet_tag: preload: true }}
  {%- endif -%}

  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" as="style" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap" onload="this.onload=null;this.rel='stylesheet'">
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500&family=Instrument+Serif:ital@0;1&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400&display=swap"></noscript>

  {{ content_for_header }}

  <script src="{{ 'global.js' | asset_url }}" defer></script>

  {%- comment -%} ── Organization + WebSite JSON-LD Schema (sitewide) ── {%- endcomment -%}
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    "url": "{{ shop.url }}",
    "logo": "{{ shop.url }}/cdn/shop/files/OurCoordinates_Logo.png",
    "description": {{ shop.description | json }},
    "contactPoint": {
      "@type": "ContactPoint",
      "contactType": "customer service",
      "email": "{{ shop.email }}"
    },
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Saint Petersburg",
      "addressRegion": "FL",
      "addressCountry": "US"
    },
    "sameAs": [
      "https://www.pinterest.com/ourcoordinates/",
      "https://www.instagram.com/ourcoordinates/",
      "https://www.facebook.com/ourcoordinates/",
      "https://www.etsy.com/shop/OurCoordinates"
    ]
  }
  </script>
  <script type="application/ld+json">
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    "name": {{ shop.name | json }},
    "url": "{{ shop.url }}",
    "potentialAction": {
      "@type": "SearchAction",
      "target": {
        "@type": "EntryPoint",
        "urlTemplate": "{{ shop.url }}/search?q={search_term_string}"
      },
      "query-input": "required name=search_term_string"
    }
  }
  </script>
</head>

<body class="template-{{ template.name }}">
  <a class="skip-link" href="#MainContent">Skip to content</a>

  {%- comment -%} Meridian ruler: fixed degree ticks down the right page edge (desktop only) {%- endcomment -%}
  <div class="meridian-ruler" aria-hidden="true">
    <span>30&deg;</span><span>20&deg;</span><span>10&deg;</span><span>0&deg;</span><span>10&deg;</span><span>20&deg;</span><span>30&deg;</span>
  </div>

  {% sections 'header-group' %}

  <main id="MainContent" role="main">
    {{ content_for_layout }}
  </main>

  {% sections 'footer-group' %}

  {% section 'cart-drawer' %}

  {%- comment -%} Screen-reader announcements for cart updates {%- endcomment -%}
  <div class="visually-hidden" aria-live="polite" role="status" data-cart-live></div>
</body>
</html>
