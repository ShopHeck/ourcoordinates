{%- liquid
  assign s = section.settings
  assign sid = section.id
  assign section_bg = settings.color_graphite
  assign section_text = settings.color_paper
  if s.color_scheme == 'light'
    assign section_bg = settings.color_paper
    assign section_text = settings.color_ink
  endif
-%}
<section class="atelier-cust-{{ sid }}">
  <div class="acu-shell">
    {%- if s.eyebrow != blank -%}<div class="acu-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h2 class="acu-h2">{{ s.heading }}</h2>
    {%- if s.counter_number != blank -%}
      <div class="acu-counter-row">
        <span class="acu-counter" data-target="{{ s.counter_number }}">{{ s.counter_number }}</span>
        {%- if s.counter_caption != blank -%}<span class="acu-counter-cap">{{ s.counter_caption }}</span>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="acu-rows">
      {%- for block in section.blocks -%}
        {%- assign b = block.settings -%}
        <div class="acu-row{% if forloop.even %} acu-flip{% endif %}" {{ block.shopify_attributes }}>
          <div class="acu-photo">
            {%- if b.photo != blank -%}
              {{ b.photo | image_url: width: 1000 | image_tag: loading: 'lazy', alt: b.name, widths: '500, 750, 1000' }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'acu-placeholder' }}
            {%- endif -%}
          </div>
          <div>
            {%- if b.quote != blank -%}<p class="acu-quote">{{ b.quote }}</p>{%- endif -%}
            {%- if b.story != blank -%}<p class="acu-story">{{ b.story }}</p>{%- endif -%}
            <div class="acu-coord"><b>{{ b.coord_label }}</b> — {{ b.coord_value }} · {{ b.name }}</div>
            {%- if b.piece_product != blank -%}
              <a class="acu-shop" href="{{ b.piece_product.url }}">{{ s.shop_label }} — {{ b.piece_product.title }}, {{ b.piece_product.price | money }} →</a>
            {%- elsif b.piece_link != blank -%}
              <a class="acu-shop" href="{{ b.piece_link }}">{{ s.shop_label }} →</a>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

<style>
  #shopify-section-{{ sid }} .atelier-cust-{{ sid }}{
    background:{{ section_bg }};color:{{ section_text }};
    font-family:var(--f-body);font-size:15px;line-height:1.55;
    padding:clamp(72px,9vw,130px) clamp(20px,5vw,72px);
  }
  #shopify-section-{{ sid }} .acu-shell{max-width:1240px;margin:0 auto}
  #shopify-section-{{ sid }} .acu-eyebrow{
    font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:{{ section_text | color_modify: 'alpha', 0.72 }};
    margin-bottom:20px;display:flex;align-items:center;gap:14px;
  }
  #shopify-section-{{ sid }} .acu-eyebrow::before{content:"";width:36px;height:1px;background:{{ section_text | color_modify: 'alpha', 0.72 }}}
  #shopify-section-{{ sid }} .acu-h2{
    font-family:var(--f-display);font-weight:400;
    font-size:clamp(34px,4.2vw,60px);line-height:1.04;letter-spacing:-.015em;margin:0;color:{{ section_text }};
  }
  #shopify-section-{{ sid }} .acu-h2 em{font-style:italic}
  #shopify-section-{{ sid }} .acu-counter-row{display:flex;align-items:baseline;gap:18px;margin-top:26px;flex-wrap:wrap}
  #shopify-section-{{ sid }} .acu-counter{font-family:var(--f-display);font-size:clamp(40px,4.6vw,64px);line-height:1}
  #shopify-section-{{ sid }} .acu-counter-cap{font-size:11.5px;letter-spacing:.2em;text-transform:uppercase;opacity:.6;max-width:24ch;line-height:1.6}
  #shopify-section-{{ sid }} .acu-rows{margin-top:clamp(48px,6vw,80px);display:flex;flex-direction:column}
  #shopify-section-{{ sid }} .acu-row{
    display:grid;grid-template-columns:1fr 1fr;gap:clamp(28px,4vw,72px);align-items:center;
    padding:clamp(36px,4vw,60px) 0;border-top:1px solid {{ section_text | color_modify: 'alpha', 0.22 }};
  }
  #shopify-section-{{ sid }} .acu-row:last-child{border-bottom:1px solid {{ section_text | color_modify: 'alpha', 0.22 }}}
  #shopify-section-{{ sid }} .acu-photo{overflow:hidden}
  #shopify-section-{{ sid }} .acu-photo img,
  #shopify-section-{{ sid }} .acu-photo svg{width:100%;aspect-ratio:1/1;object-fit:cover;display:block;transition:transform 1.2s cubic-bezier(.2,.8,.2,1)}
  #shopify-section-{{ sid }} .acu-row:hover .acu-photo img{transform:scale(1.03)}
  #shopify-section-{{ sid }} .acu-flip .acu-photo{order:2}
  #shopify-section-{{ sid }} .acu-quote{margin:18px 0 0;font-family:var(--f-display);font-size:clamp(22px,2.2vw,30px);line-height:1.3}
  #shopify-section-{{ sid }} .acu-quote em{font-style:italic}
  #shopify-section-{{ sid }} .acu-story{margin:16px 0 0;color:{{ section_text | color_modify: 'alpha', 0.75 }};font-size:14.5px;max-width:46ch}
  #shopify-section-{{ sid }} .acu-coord{margin-top:18px;font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:{{ section_text | color_modify: 'alpha', 0.65 }}}
  #shopify-section-{{ sid }} .acu-coord b{color:{{ section_text }};font-weight:600}
  #shopify-section-{{ sid }} .acu-shop{
    margin-top:22px;display:inline-flex;align-items:center;gap:10px;
    font-family:var(--f-display);font-style:italic;font-size:18px;color:{{ section_text }};
    text-decoration:none;border-bottom:1px solid {{ section_text | color_modify: 'alpha', 0.5 }};padding-bottom:3px;
    transition:border-color .3s,gap .3s;
  }
  #shopify-section-{{ sid }} .acu-shop:hover{border-color:{{ section_text }};gap:16px}
  @media(max-width:820px){
    #shopify-section-{{ sid }} .acu-row{grid-template-columns:1fr}
    #shopify-section-{{ sid }} .acu-flip .acu-photo{order:0}
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ sid }} .acu-photo img{transition:none}
  }
</style>

<script>
(function(){
  var root = document.getElementById('shopify-section-{{ sid }}');
  if (!root) return;
  var el = root.querySelector('.acu-counter');
  if (!el) return;
  var target = parseInt((el.getAttribute('data-target') || '0').replace(/[^0-9]/g, ''), 10) || 0;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function render(v){ el.textContent = v.toLocaleString('en-US'); }
  if (reduced){ render(target); return; }
  var done = false;
  function count(){
    if (done) return; done = true;
    var t0 = null;
    function step(ts){
      if (!t0) t0 = ts;
      var p = Math.min(1, (ts - t0) / 1600);
      render(Math.floor(target * (1 - Math.pow(1 - p, 3))));
      if (p < 1) requestAnimationFrame(step); else render(target);
    }
    requestAnimationFrame(step);
  }
  if ('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(en){
      en.forEach(function(e){ if (e.isIntersecting){ count(); io.disconnect(); } });
    }, {threshold:.4});
    io.observe(el);
  } else { count(); }
})();
</script>

{% schema %}
{
  "name": "Atelier Story Ideas",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Gift inspiration" },
    { "type": "textarea", "id": "heading", "label": "Heading (HTML allowed)", "default": "Places worth<br><em>carrying.</em>" },
    { "type": "text", "id": "counter_number", "label": "Documented count (optional)", "info": "Only use a number supported by store records. Leave blank otherwise." },
    { "type": "text", "id": "counter_caption", "label": "Counter caption" },
    { "type": "text", "id": "shop_label", "label": "Link label", "default": "Explore this idea" },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "dark", "label": "Theme dark" },
        { "value": "light", "label": "Theme light" }
      ],
      "default": "dark"
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "Story idea",
      "settings": [
        { "type": "image_picker", "id": "photo", "label": "Inspiration image" },
        { "type": "text", "id": "name", "label": "Idea label", "default": "THE PROPOSAL" },
        { "type": "textarea", "id": "quote", "label": "Headline (optional)" },
        { "type": "textarea", "id": "story", "label": "Idea", "default": "Engrave the coordinates of where you said yes, then add the date or a short message that only the two of you understand." },
        { "type": "text", "id": "coord_label", "label": "Coordinates label", "default": "A proposal place" },
        { "type": "text", "id": "coord_value", "label": "Coordinates", "default": "27.7676° N, 82.6403° W" },
        { "type": "product", "id": "piece_product", "label": "Product (“Shop their piece”)" },
        { "type": "url", "id": "piece_link", "label": "Fallback link (if no product picked)" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Atelier Story Ideas",
      "category": "Atelier",
      "blocks": [
        { "type": "story" },
        { "type": "story", "settings": { "name": "A NEW BEGINNING", "story": "Mark a birthplace, first home, or city that began a new chapter with coordinates chosen by the person giving the gift.", "coord_label": "A meaningful beginning", "coord_value": "32.7767° N, 96.7970° W" } },
        { "type": "story", "settings": { "name": "WHERE YOU MET", "story": "Turn the café, campus, station, or neighborhood where your paths crossed into a matching everyday reminder.", "coord_label": "A shared starting point", "coord_value": "40.7411° N, 73.9897° W" } }
      ]
    }
  ]
}
{% endschema %}
