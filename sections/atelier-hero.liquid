{%- liquid
  assign s = section.settings
-%}
<header class="atelier-hero-{{ section.id }}">
  <div class="ah-bg">
    {%- if s.image != blank -%}
      {{ s.image | image_url: width: 2400 | image_tag: loading: 'eager', fetchpriority: 'high', alt: s.image_alt, widths: '800, 1200, 1600, 2000, 2400' }}
    {%- else -%}
      <picture>
        <source media="(max-width: 700px)" srcset="{{ 'hero-necklace-mobile.jpg' | asset_url }}">
        <img src="{{ 'hero-necklace.jpg' | asset_url }}" alt="{{ s.image_alt | escape }}" width="1200" height="638" loading="eager" fetchpriority="high" decoding="async">
      </picture>
    {%- endif -%}
  </div>
  <div class="ah-veil" aria-hidden="true"></div>
  <div class="ah-inner">
    {%- if s.eyebrow != blank -%}<div class="ah-eyebrow">{{ s.eyebrow }}</div>{%- endif -%}
    <h1 class="ah-h1">{{ s.headline }}</h1>
    {%- if s.subline != blank -%}<p class="ah-sub">{{ s.subline }}</p>{%- endif -%}

    {%- if s.show_etching -%}
    <div class="ah-etch" aria-hidden="true">
      <svg viewBox="0 0 520 54">
        <path class="ah-etch-line" d="M4 42 H516" fill="none" stroke="rgba(121,94,63,.45)" stroke-width="1"/>
        <text class="ah-etch-text" x="4" y="30" font-family="Inter, sans-serif" font-weight="500" font-size="19" letter-spacing="3.5" fill="{{ s.color_text }}"></text>
        <circle class="ah-spark" cx="4" cy="42" r="3" fill="#fff3d6" opacity="0"/>
        <circle class="ah-spark-halo" cx="4" cy="42" r="8" fill="none" stroke="#fff3d6" stroke-width="1" opacity="0"/>
      </svg>
      <div class="ah-etch-cap">{{ s.etch_caption }}</div>
    </div>
    {%- endif -%}

    <div class="ah-actions">
      {%- if s.cta1_label != blank -%}<a class="ah-btn" href="{{ s.cta1_link | default: '#' }}">{{ s.cta1_label }}</a>{%- endif -%}
      {%- if s.cta2_label != blank -%}<a class="ah-ghost" href="{{ s.cta2_link | default: '#' }}">{{ s.cta2_label }}</a>{%- endif -%}
    </div>
    {%- if s.ship_line != blank -%}
    <div class="ah-ship"><span class="ah-pulse"></span><span>{{ s.ship_line }}</span></div>
    {%- endif -%}
  </div>
</header>

<style>
  #shopify-section-{{ section.id }} .atelier-hero-{{ section.id }}{
    position:relative;min-height:{{ s.height }}vh;display:flex;align-items:center;overflow:hidden;
    background:{{ s.color_bg }};color:{{ s.color_text }};
    font-family:'Inter', -apple-system, sans-serif;font-size:15px;line-height:1.55;
  }
  #shopify-section-{{ section.id }} .ah-bg{position:absolute;inset:0}
  #shopify-section-{{ section.id }} .ah-bg img,
  #shopify-section-{{ section.id }} .ah-bg picture,
  #shopify-section-{{ section.id }} .ah-bg svg{width:100%;height:100%;object-fit:cover;object-position:62% 40%;display:block}
  #shopify-section-{{ section.id }} .ah-bg picture img{width:100%;height:100%;object-fit:cover;object-position:62% 40%}
  #shopify-section-{{ section.id }} .ah-veil{
    position:absolute;inset:0;
    background:linear-gradient(100deg, rgba(255,249,239,.97) 0%, rgba(255,249,239,.88) 30%, rgba(255,249,239,.45) 58%, rgba(255,249,239,0) 78%);
  }
  #shopify-section-{{ section.id }} .ah-inner{position:relative;width:100%;max-width:1240px;margin:0 auto;padding:110px clamp(20px,5vw,72px) 90px}
  #shopify-section-{{ section.id }} .ah-eyebrow{
    font-size:11px;letter-spacing:.22em;text-transform:uppercase;color:rgba(121,94,63,.45);
    margin-bottom:26px;display:flex;align-items:center;gap:14px;
  }
  #shopify-section-{{ section.id }} .ah-eyebrow::before{content:"";width:36px;height:1px;background:rgba(121,94,63,.45)}
  #shopify-section-{{ section.id }} .ah-h1{
    font-family:'Instrument Serif', Georgia, serif;font-weight:400;
    font-size:clamp(50px,6.8vw,98px);line-height:.99;letter-spacing:-.02em;margin:0;
    color:{{ s.color_text }};
  }
  #shopify-section-{{ section.id }} .ah-h1 em{font-style:italic}
  #shopify-section-{{ section.id }} .ah-sub{margin:26px 0 0;font-size:clamp(15px,1.3vw,18px);color:rgba(121,94,63,.7);max-width:44ch}
  #shopify-section-{{ section.id }} .ah-etch{margin-top:34px;max-width:520px}
  #shopify-section-{{ section.id }} .ah-etch svg{width:100%;height:auto;overflow:visible;display:block}
  #shopify-section-{{ section.id }} .ah-etch-cap{font-size:11px;letter-spacing:.2em;text-transform:uppercase;color:rgba(121,94,63,.45);margin-top:8px}
  #shopify-section-{{ section.id }} .ah-actions{margin-top:34px;display:flex;gap:20px;align-items:center;flex-wrap:wrap}
  #shopify-section-{{ section.id }} .ah-btn{
    font-family:'Instrument Serif', Georgia, serif;font-style:italic;font-size:19px;
    background:{{ s.color_text }};color:{{ s.color_bg }};text-decoration:none;
    padding:14px 34px;border-radius:100px;transition:background .3s cubic-bezier(.2,.8,.2,1),letter-spacing .3s;
  }
  #shopify-section-{{ section.id }} .ah-btn:hover{background:#5f4830;letter-spacing:.02em}
  #shopify-section-{{ section.id }} .ah-ghost{
    color:{{ s.color_text }};text-decoration:none;font-size:12px;letter-spacing:.14em;text-transform:uppercase;
    border-bottom:1px solid rgba(121,94,63,.45);padding-bottom:3px;transition:border-color .3s;
  }
  #shopify-section-{{ section.id }} .ah-ghost:hover{border-color:{{ s.color_text }}}
  #shopify-section-{{ section.id }} .ah-ship{margin-top:22px;font-size:12.5px;color:rgba(121,94,63,.7);display:flex;align-items:center;gap:9px}
  #shopify-section-{{ section.id }} .ah-pulse{width:7px;height:7px;border-radius:50%;background:{{ s.color_text }};animation:ah-pulse-{{ section.id }} 2s ease-in-out infinite}
  @keyframes ah-pulse-{{ section.id }}{0%,100%{opacity:.35}50%{opacity:1}}
  @media(max-width:700px){
    #shopify-section-{{ section.id }} .atelier-hero-{{ section.id }}{min-height:auto}
    #shopify-section-{{ section.id }} .ah-veil{background:linear-gradient(180deg, rgba(255,249,239,.95) 0%, rgba(255,249,239,.8) 55%, rgba(255,249,239,.55) 100%)}
  }
  @media (prefers-reduced-motion: reduce){
    #shopify-section-{{ section.id }} .ah-pulse{animation:none}
  }
</style>

{%- if s.show_etching -%}
<script>
(function(){
  var root = document.getElementById('shopify-section-{{ section.id }}');
  if (!root) return;
  var text = root.querySelector('.ah-etch-text');
  var line = root.querySelector('.ah-etch-line');
  var spark = root.querySelector('.ah-spark');
  var halo = root.querySelector('.ah-spark-halo');
  var COORD = {{ s.etch_text | json }};
  if (!text || !line) return;
  var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (reduced){
    text.textContent = COORD;
    return;
  }
  var lineLen = line.getTotalLength();
  line.style.strokeDasharray = lineLen;
  line.style.strokeDashoffset = lineLen;
  var i = 0;
  setTimeout(function(){
    var t = setInterval(function(){
      i++;
      text.textContent = COORD.slice(0, i);
      var frac = i / COORD.length;
      line.style.strokeDashoffset = lineLen * (1 - frac);
      var x = 4 + 512 * frac;
      spark.setAttribute('cx', x); halo.setAttribute('cx', x);
      spark.setAttribute('opacity','1'); halo.setAttribute('opacity','.5');
      if (i >= COORD.length){
        clearInterval(t);
        setTimeout(function(){ spark.setAttribute('opacity','0'); halo.setAttribute('opacity','0'); }, 700);
      }
    }, 80);
  }, 900);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Atelier Hero",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image", "info": "Use images/hero-necklace.jpg from the Atelier image set." },
    { "type": "text", "id": "image_alt", "label": "Image alt text", "default": "Gold bar necklace engraved with coordinates, resting on cream linen" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Custom coordinates jewelry · engraved to order in the USA" },
    { "type": "textarea", "id": "headline", "label": "Headline (HTML allowed)", "default": "Some <em>places</em><br>deserve to<br>be <em>worn.</em>" },
    { "type": "textarea", "id": "subline", "label": "Subline", "default": "Every piece is laser-engraved with the latitude & longitude of the place that made you — then photographed and sent to you for approval before it ever ships." },
    { "type": "checkbox", "id": "show_etching", "label": "Show self-etching coordinates line", "default": true },
    { "type": "text", "id": "etch_text", "label": "Etching coordinates", "default": "48.8584° N, 2.2945° E" },
    { "type": "text", "id": "etch_caption", "label": "Etching caption", "default": "Yours begins here — type a place below" },
    { "type": "text", "id": "cta1_label", "label": "Primary button label", "default": "Open the preview studio" },
    { "type": "url", "id": "cta1_link", "label": "Primary button link" },
    { "type": "text", "id": "cta2_label", "label": "Secondary link label", "default": "Start with your story →" },
    { "type": "url", "id": "cta2_link", "label": "Secondary link" },
    { "type": "text", "id": "ship_line", "label": "Shipping line", "default": "Order today — ships within 5 business days" },
    { "type": "range", "id": "height", "label": "Height (vh)", "min": 60, "max": 100, "step": 2, "default": 92 },
    { "type": "color", "id": "color_bg", "label": "Background", "default": "#fff9ef" },
    { "type": "color", "id": "color_text", "label": "Text", "default": "#795e3f" }
  ],
  "presets": [
    { "name": "Atelier Hero", "category": "Atelier" }
  ]
}
{% endschema %}
