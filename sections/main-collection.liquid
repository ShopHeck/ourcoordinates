{%- liquid
  assign collection_has_seo_copy = false
  if collection.metafields.custom.seo_copy.value != blank
    assign collection_has_seo_copy = true
  endif
-%}

<section class="section collection-page">
  <div class="page-width">
    <div class="collection-head">
      <p class="coord-eyebrow">{{ section.settings.eyebrow | default: 'Collection' }}</p>
      {%- comment -%}
        H1 overrides. `for-couples` was titled "Valentine's Day Specials" in
        admin, so its H1 contradicted its <title> ("Couples Jewelry…") all
        year (Sept 2026 audit). Renaming the collection in admin is the
        permanent fix; this keeps the page coherent until then.
      {%- endcomment -%}
      {%- liquid
        assign collection_h1 = collection.title
        if collection.handle == 'all'
          assign collection_h1 = 'Personalized Jewelry &amp; Coordinates Gifts'
        elsif collection.handle == 'for-couples'
          assign collection_h1 = 'Couples Jewelry &amp; Matching Sets'
        endif
      -%}
      <h1>{{ collection_h1 }}</h1>
      {%- comment -%}
        Occasion order-by banner for seasonal collection templates.
        Order-by date = occasion minus production, transit, and the same
        3-day buffer as the PDP delivery estimate. Hides itself once too
        late or past; an unparseable date fails closed.
      {%- endcomment -%}
      {%- if section.settings.occasion_label != blank and section.settings.occasion_date != blank -%}
        {%- liquid
          assign now_ts = 'now' | date: '%s' | plus: 0
          assign occasion_ts = section.settings.occasion_date | date: '%s' | plus: 0
          assign prod_s = settings.production_days | times: 86400
          assign transit_s = settings.transit_days | times: 86400
          assign lead_s = prod_s | plus: transit_s | plus: 259200
          assign order_by_ts = occasion_ts | minus: lead_s
        -%}
        {%- if occasion_ts > now_ts and order_by_ts >= now_ts -%}
          <p class="pdp__occasion collection-occasion">
            <span class="pdp__occasion-dot" aria-hidden="true">◆</span>
            Order by <strong>{{ order_by_ts | date: '%A, %b %-d' }}</strong> to have it engraved, checked, and delivered for {{ section.settings.occasion_label }}.
          </p>
        {%- endif -%}
      {%- endif -%}
    </div>

    {%- liquid
      assign selected_sort = collection.sort_by | default: collection.default_sort_by
      assign active_filter_count = 0
      for filter in collection.filters
        assign active_filter_count = active_filter_count | plus: filter.active_values.size
        if filter.min_value.value != nil or filter.max_value.value != nil
          assign active_filter_count = active_filter_count | plus: 1
        endif
      endfor
    -%}
    <form class="collection-controls" method="get">
      <label class="collection-controls__sort">
        <span>Sort</span>
        <select name="sort_by" onchange="this.form.submit()">
          {%- for option in collection.sort_options -%}
            <option value="{{ option.value | escape }}"{% if option.value == selected_sort %} selected{% endif %}>{{ option.name }}</option>
          {%- endfor -%}
        </select>
      </label>

      {%- for filter in collection.filters -%}
        <details class="collection-filter"{% if filter.active_values.size > 0 %} open{% endif %}>
          <summary>{{ filter.label }}{% if filter.active_values.size > 0 %} ({{ filter.active_values.size }}){% endif %}</summary>
          <div class="collection-filter__body">
            {%- case filter.type -%}
              {%- when 'boolean', 'list' -%}
                {%- for value in filter.values -%}
                  <label>
                    <input type="checkbox" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked{% endif %}{% if value.count == 0 and value.active == false %} disabled{% endif %}>
                    <span>{{ value.label }} <small>({{ value.count }})</small></span>
                  </label>
                {%- endfor -%}
              {%- when 'price_range' -%}
                <div class="collection-filter__price">
                  <label>Min <input name="{{ filter.min_value.param_name }}" inputmode="decimal" value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}" placeholder="0"></label>
                  <label>Max <input name="{{ filter.max_value.param_name }}" inputmode="decimal" value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}" placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"></label>
                </div>
            {%- endcase -%}
          </div>
        </details>
      {%- endfor -%}

      {%- if collection.filters.size > 0 -%}<button class="btn btn--ghost collection-controls__apply" type="submit">Apply</button>{%- endif -%}
      {%- if active_filter_count > 0 -%}<a href="{{ collection.url }}?sort_by={{ selected_sort }}">Clear filters</a>{%- endif -%}
    </form>

    {%- paginate collection.products by 24 -%}
      {%- if collection.products_count == 0 -%}
        <div class="collection-empty">
          <p class="coord-eyebrow">0 results here</p>
          <p>Nothing in this collection yet — but every piece we make can carry your place.</p>
          <a class="btn" href="{{ routes.all_products_collection_url }}">Shop all pieces</a>
        </div>
      {%- else -%}
        {%- assign rendered_products = 0 -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {%- if section.settings.hide_sold_out and product.available == false -%}{%- continue -%}{%- endif -%}
            {%- assign rendered_products = rendered_products | plus: 1 -%}
            {%- liquid
              assign card_loading = 'lazy'
              assign card_priority = 'auto'
              if paginate.current_page == 1 and rendered_products <= 2
                assign card_loading = 'eager'
                assign card_priority = 'high'
              endif
            -%}
            {%- render 'product-card', card_product: product, image_loading: card_loading, image_fetchpriority: card_priority -%}
          {%- endfor -%}
        </div>
        {%- if rendered_products == 0 -%}
          <div class="collection-empty">
            <p>No available pieces match this page or filter yet.</p>
            <a class="btn" href="{{ collection.url }}">Clear filters</a>
          </div>
        {%- endif -%}
      {%- endif -%}

      {%- if paginate.pages > 1 -%}
        <nav class="pagination" aria-label="Pagination">
          {%- if paginate.previous -%}<a href="{{ paginate.previous.url }}">‹</a>{%- endif -%}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}">{{ part.title }}</a>
            {%- elsif part.title == paginate.current_page -%}
              <span class="current">{{ part.title }}</span>
            {%- else -%}
              <span>{{ part.title }}</span>
            {%- endif -%}
          {%- endfor -%}
          {%- if paginate.next -%}<a href="{{ paginate.next.url }}">›</a>{%- endif -%}
        </nav>
      {%- endif -%}

      {%- liquid
        assign show_collection_description = false
        if paginate.current_page == 1 and active_filter_count == 0 and collection.sort_by == blank and current_tags == blank
          unless collection_has_seo_copy
            if collection.description != blank or collection.handle == 'all'
              assign show_collection_description = true
            endif
          endunless
        endif
      -%}
      {%- if show_collection_description -%}
        <section class="collection-description" aria-labelledby="CollectionDescriptionTitle-{{ section.id }}">
          <h2 id="CollectionDescriptionTitle-{{ section.id }}">{{ 'collections.general.about_collection' | t: title: collection.title }}</h2>
          {%- if collection.description != blank -%}
            <div class="rte collection-description__body">{{ collection.description }}</div>
          {%- else -%}
            <p class="collection-description__body">{{ 'collections.general.all_products_intro' | t }}</p>
          {%- endif -%}
        </section>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection page",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Collection",
      "info": "Small label above the title, e.g. 'Holiday 2026 gift guide'."
    },
    {
      "type": "text",
      "id": "occasion_label",
      "label": "Occasion (order-by banner)",
      "info": "e.g. Christmas. Shows 'Order by <date>…' computed from your lead + transit times. Leave blank to hide."
    },
    {
      "type": "text",
      "id": "occasion_date",
      "label": "Occasion date (YYYY-MM-DD)",
      "info": "The banner hides itself automatically once it's too late to deliver in time, or after the date passes."
    },
    {
      "type": "checkbox",
      "id": "hide_sold_out",
      "label": "Hide sold-out products",
      "default": true
    }
  ]
}
{% endschema %}
