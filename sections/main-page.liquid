{%- if page.handle == 'about-us' -%}
  {% render 'about-us-page' %}
{%- elsif page.handle == 'contact' -%}
  {% render 'contact-us-page' %}
{%- elsif page.handle == 'shipping' or page.handle == 'faqs' -%}
  {% render 'storefront-help' %}
{%- else -%}
  <section class="section">
    <div class="page-width page-narrow">
      <p class="coord-eyebrow">{{ shop.name }}</p>
      {%- unless page.handle == 'about-michael-heckert-founder-creator' -%}
        <h1>{{ page.title }}</h1>
      {%- endunless -%}
      {%- liquid
        assign page_body = page.content
        for fix in page.metafields.custom.storefront_link_fixes.value
          assign page_body = page_body | replace: fix.original, fix.replacement
        endfor
      -%}
      {%- capture gift_cards -%}
        {%- for gift_product in page.metafields.custom.holiday_gifts.value -%}
          {%- if gift_product.available -%}
            {%- render 'product-card', card_product: gift_product -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endcapture -%}
      {%- capture gift_heading -%}<h2>Shop {{ page.title | escape }} gifts</h2>{%- endcapture -%}
      {%- assign gift_sections = page_body | split: gift_heading -%}
      {%- assign after_heading = gift_sections.last | strip -%}
      {%- assign list_open = after_heading | slice: 0, 4 -%}
      {%- if gift_cards != blank and gift_sections.size == 2 and list_open == '<ul>' and after_heading contains '</ul>' -%}
        {%- assign fallback_list = after_heading | split: '</ul>' | first | append: '</ul>' -%}
        <div class="rte">{{ gift_sections.first }}</div>
        {{ gift_heading }}
        <div class="product-grid">{{ gift_cards }}</div>
        <div class="rte">{{ after_heading | remove_first: fallback_list }}</div>
      {%- else -%}
        <div class="rte">{{ page_body }}</div>
      {%- endif -%}
    </div>
  </section>
{%- endif -%}
{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
