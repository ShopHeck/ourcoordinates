{%- if page.handle == 'about-us' -%}
  {% render 'about-us-page' %}
{%- else -%}
  <section class="section">
    <div class="page-width page-narrow">
      <p class="coord-eyebrow">{{ shop.name }}</p>
      <h1>{{ page.title }}</h1>
      <div class="rte">{{ page.content }}</div>
    </div>
  </section>
{%- endif -%}
{% schema %}
{ "name": "Page", "settings": [] }
{% endschema %}
