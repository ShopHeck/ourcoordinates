    font-family: var(--f-coord);
    font-size: .65rem;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  #ReviewsPage-{{ section.id }} .reviews-story__body h3,
  #ReviewsPage-{{ section.id }} .reviews-story__body p {
    margin: 0;
  }

  #ReviewsPage-{{ section.id }} .reviews-story__body h3 {
    font-size: clamp(1.25rem, 2.3vw, 1.8rem);
  }

  #ReviewsPage-{{ section.id }} .reviews-story__body p {
    color: var(--c-ink-soft);
    font-size: .8rem;
  }

  #ReviewsPage-{{ section.id }} .reviews-cta {
    position: relative;
    overflow: hidden;
    padding: clamp(58px, 9vw, 112px) 0;
    background:
      linear-gradient(rgba(255,255,255,.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,.04) 1px, transparent 1px),
      var(--c-graphite);
    background-size: 34px 34px;
    color: var(--c-paper);
  }

  #ReviewsPage-{{ section.id }} .reviews-cta::after {
