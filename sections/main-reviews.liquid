    color: var(--c-ink);
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__content {
    min-width: 0;
  }

  #ReviewsPage-{{ section.id }} .reviews-page__widget {
    min-height: 280px;
    padding: clamp(20px, 3vw, 36px);
    border: 1px solid var(--c-line);
