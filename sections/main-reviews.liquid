<section id="ReviewsPage-{{ section.id }}" class="reviews-page" data-reviews-page>
  <div class="reviews-hero">
    <div class="page-width reviews-hero__grid">
      <div class="reviews-hero__copy">
        <p class="coord-eyebrow">{{ section.settings.eyebrow | escape }}</p>
        <h1>{{ section.settings.heading | escape }}</h1>
        <p class="reviews-hero__intro">{{ section.settings.intro | escape }}</p>

        <div class="reviews-hero__actions">
          <a class="btn" href="#customer-review-wall">{{ section.settings.review_button_label | escape }}</a>
          <a class="reviews-text-link" href="{{ section.settings.shop_link | default: '/collections/all' }}">
            {{ section.settings.shop_button_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        </div>

        <div class="reviews-hero__verification" aria-label="Review verification">
          <span class="reviews-hero__seal" aria-hidden="true">✓</span>
          <p><strong>Verified review platform</strong><span>Feedback published through Judge.me</span></p>
        </div>
      </div>

      <div class="reviews-hero__media">
        {%- if section.settings.hero_image != blank -%}
          {{ section.settings.hero_image | image_url: width: 1400 | image_tag: loading: 'eager', fetchpriority: 'high', widths: '480, 720, 960, 1200, 1400', sizes: '(max-width: 760px) 100vw, 45vw', alt: section.settings.hero_image_alt }}
        {%- else -%}
          <img
            src="{{ 'customer-couple.jpg' | asset_url }}"
            alt="{{ section.settings.hero_image_alt | escape }}"
            width="1200"
            height="1500"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}
        <div class="reviews-hero__coordinates" aria-hidden="true">
          <span>27.7676° N</span>
          <span>82.6403° W</span>
        </div>
        <div class="reviews-hero__caption">
          <span>Every place holds a story.</span>
          <strong>Wear yours.</strong>
        </div>
      </div>
    </div>
  </div>

  <div class="reviews-assurances" aria-label="Our ordering promises">
    <div class="page-width reviews-assurances__grid">
      <div class="reviews-assurances__item">
        <span aria-hidden="true">01</span>
        <p><strong>Made personal</strong>Engraved with the place or words that matter to you.</p>
      </div>
      <div class="reviews-assurances__item">
        <span aria-hidden="true">02</span>
        <p><strong>Preview with confidence</strong>See your personalization before adding it to your cart.</p>
      </div>
      <div class="reviews-assurances__item">
        <span aria-hidden="true">03</span>
        <p><strong>{{ settings.guarantee_1 | default: 'Free remake if we get it wrong' | escape }}</strong>Real help from a family-owned business.</p>
      </div>
    </div>
  </div>

  <div id="customer-review-wall" class="reviews-wall section" data-review-wall>
    <div class="page-width reviews-wall__layout">
      <aside class="reviews-wall__summary" aria-labelledby="review-wall-heading">
        <p class="coord-eyebrow">The review wall</p>
        <h2 id="review-wall-heading">{{ section.settings.wall_heading | escape }}</h2>
        <p>{{ section.settings.wall_intro | escape }}</p>

        <div class="reviews-wall__live-summary" data-live-summary hidden>
          <div data-rating-metric hidden>
            <strong data-rating-value>—</strong>
            <span>Average rating</span>
          </div>
          <div data-count-metric hidden>
            <strong data-review-count>—</strong>
            <span>Published reviews</span>
          </div>
        </div>

        <div class="reviews-wall__note">
          <span aria-hidden="true">◆</span>
          <p><strong>Looking for a specific piece?</strong> Product-specific ratings also appear directly on each product page.</p>
        </div>
      </aside>

      <div class="reviews-wall__content">
        <div class="reviews-page__widget" data-all-reviews aria-live="polite">
          <div class="jdgm-widget jdgm-all-reviews-widget" data-from-snippet="true"></div>
          <div class="reviews-page__fallback" data-reviews-fallback>
            <span class="reviews-page__fallback-mark" aria-hidden="true">◇</span>
            <h3>Customer stories are loading</h3>
            <p>Reviews will appear here as soon as the review platform finishes loading.</p>
            <a href="/pages/contact">Need help with an order? Contact us</a>
          </div>
        </div>
      </div>
    </div>
  </div>

  <div class="reviews-stories section">
    <div class="page-width">
      <div class="reviews-stories__head">
        <div>
          <p class="coord-eyebrow">Made from memory</p>
          <h2>{{ section.settings.stories_heading | escape }}</h2>
        </div>
        <p>{{ section.settings.stories_intro | escape }}</p>
      </div>

      <div class="reviews-stories__grid">
        <article class="reviews-story reviews-story--large">
          <div class="reviews-story__media">
            {%- if section.settings.story_image_one != blank -%}
              {{ section.settings.story_image_one | image_url: width: 1200 | image_tag: loading: 'lazy', widths: '480, 720, 960, 1200', sizes: '(max-width: 760px) 100vw, 55vw', alt: section.settings.story_image_one_alt }}
            {%- else -%}
              <img src="{{ 'customer-mother.jpg' | asset_url }}" alt="{{ section.settings.story_image_one_alt | escape }}" width="1000" height="1250" loading="lazy">
            {%- endif -%}
          </div>
          <div class="reviews-story__body">
            <span>01 / Family</span>
            <h3>Where home will always be</h3>
            <p>A birthplace, childhood home, or place that still feels like yours.</p>
          </div>
        </article>

        <article class="reviews-story">
          <div class="reviews-story__media">
            {%- if section.settings.story_image_two != blank -%}
              {{ section.settings.story_image_two | image_url: width: 1000 | image_tag: loading: 'lazy', widths: '360, 540, 720, 1000', sizes: '(max-width: 760px) 100vw, 38vw', alt: section.settings.story_image_two_alt }}
            {%- else -%}
              <img src="{{ 'customer-friends.jpg' | asset_url }}" alt="{{ section.settings.story_image_two_alt | escape }}" width="900" height="1100" loading="lazy">
            {%- endif -%}
          </div>
          <div class="reviews-story__body">
            <span>02 / Friendship</span>
            <h3>Where you found your people</h3>
            <p>The city, campus, or corner that made a friendship.</p>
          </div>
        </article>
      </div>
    </div>
  </div>

  <div class="reviews-cta">
    <div class="page-width reviews-cta__inner">
      <div>
        <p class="coord-eyebrow">Your story, precisely placed</p>
        <h2>{{ section.settings.cta_heading | escape }}</h2>
      </div>
      <div class="reviews-cta__action">
        <p>{{ section.settings.cta_intro | escape }}</p>
        <a class="btn" href="{{ section.settings.shop_link | default: '/collections/all' }}">{{ section.settings.cta_button_label | escape }}</a>
      </div>
    </div>
  </div>
</section>

<style>
