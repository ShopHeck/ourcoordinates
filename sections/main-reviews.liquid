    display: flex;
    flex-wrap: wrap;
    gap: 14px 24px;
    align-items: center;
    margin-top: 30px;
  }

  #ReviewsPage-{{ section.id }} .reviews-text-link {
    display: inline-flex;
    gap: 10px;
