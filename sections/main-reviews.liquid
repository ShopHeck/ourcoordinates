    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #ReviewsPage-{{ section.id }} .reviews-assurances__item {
    display: grid;
    grid-template-columns: 34px 1fr;
    gap: 12px;
    padding: 24px clamp(16px, 3vw, 34px);
    border-right: 1px solid var(--c-line);
  }

  #ReviewsPage-{{ section.id }} .reviews-assurances__item:first-child {
    padding-left: 0;
  }

  #ReviewsPage-{{ section.id }} .reviews-assurances__item:last-child {
    padding-right: 0;
    border-right: 0;
  }

  #ReviewsPage-{{ section.id }} .reviews-assurances__item > span {
    padding-top: 2px;
    color: var(--c-gold-text);
    font-family: var(--f-coord);
