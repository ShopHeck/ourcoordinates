    align-items: start;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__summary {
    position: sticky;
    top: 118px;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__summary h2 {
    max-width: 10ch;
    margin-bottom: 16px;
    font-size: clamp(2.3rem, 4vw, 4.2rem);
    line-height: .98;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__summary > p:not(.coord-eyebrow) {
    max-width: 36ch;
    margin: 0;
    color: var(--c-ink-soft);
    font-size: .9rem;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin-top: 26px;
    border: 1px solid var(--c-line);
    background: var(--c-line);
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary[hidden] {
    display: none;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary > div {
    min-width: 0;
    padding: 14px;
    background: var(--reviews-white);
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary strong,
  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary span {
    display: block;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary strong {
    color: var(--c-gold-text);
    font-family: var(--f-display);
    font-size: 1.5rem;
    font-weight: 500;
  }

  #ReviewsPage-{{ section.id }} .reviews-wall__live-summary span {
    color: var(--c-ink-soft);
