</style>

<script>
  (function () {
    var root = document.getElementById('ReviewsPage-{{ section.id }}');
    if (!root) return;

    var widget = root.querySelector('.jdgm-all-reviews-widget');
    var fallback = root.querySelector('[data-reviews-fallback]');
    var summary = root.querySelector('[data-live-summary]');
    var ratingMetric = root.querySelector('[data-rating-metric]');
    var ratingValue = root.querySelector('[data-rating-value]');
    var countMetric = root.querySelector('[data-count-metric]');
    var reviewCount = root.querySelector('[data-review-count]');
    if (!widget || !fallback) return;

    function firstNumber(elements, max) {
      for (var i = 0; i < elements.length; i += 1) {
        var match = (elements[i].textContent || '').match(/\d+(?:\.\d+)?/);
        if (!match) continue;
        var value = Number(match[0]);
        if (Number.isFinite(value) && (!max || value <= max)) return match[0];
      }
      return '';
    }

    function syncReviews() {
      var hasReviews = Boolean(widget.querySelector('.jdgm-rev, .jdgm-all-reviews-page__wrapper, [data-review-id]'));
      fallback.hidden = hasReviews;

      var rating = firstNumber(widget.querySelectorAll('.jdgm-all-reviews-rating, .jdgm-rev-widg__summary-average, [data-average-rating]'), 5);
      var count = firstNumber(widget.querySelectorAll('.jdgm-all-reviews-count, .jdgm-rev-widg__summary-text, [data-number-of-reviews]'));

      if (rating && ratingValue && ratingMetric) {
        ratingValue.textContent = rating + ' / 5';
        ratingMetric.hidden = false;
      }

      if (count && reviewCount && countMetric) {
        reviewCount.textContent = count;
        countMetric.hidden = false;
      }

      if (summary && ((ratingMetric && !ratingMetric.hidden) || (countMetric && !countMetric.hidden))) {
        summary.hidden = false;
      }
    }

    if ('MutationObserver' in window) {
      new MutationObserver(syncReviews).observe(widget, { childList: true, subtree: true, characterData: true });
    }
    syncReviews();
  })();
</script>

