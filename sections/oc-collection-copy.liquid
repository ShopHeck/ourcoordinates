{%- comment -%}
  oc-collection-copy.liquid
  Below-grid SEO editorial (collection.metafields.custom.seo_copy) plus one
  CollectionPage JSON-LD graph for SERP / AI-agent visibility.
  Editorial renders only on the canonical, unfiltered first page. The schema
  remains available when the metafield is empty, so this is safe fleet-wide.
{%- endcomment -%}

{%- liquid
  assign oc_seo = collection.metafields.custom.seo_copy.value
  assign oc_active_filter_count = 0
  for filter in collection.filters
    assign oc_active_filter_count = oc_active_filter_count | plus: filter.active_values.size
    if filter.min_value.value != nil or filter.max_value.value != nil
      assign oc_active_filter_count = oc_active_filter_count | plus: 1
    endif
  endfor
  assign oc_show_editorial = false
  if oc_seo != blank and current_page == 1 and oc_active_filter_count == 0 and collection.sort_by == blank and current_tags == blank
    assign oc_show_editorial = true
  endif
-%}
{%- if oc_show_editorial -%}
  <section class="section oc-collection-copy">
    <div class="page-width">
      <style>
        .oc-collection-copy { border-top: 1px solid var(--c-line); }
        .oc-collection-copy__body { max-width: 72ch; }
        .oc-collection-copy__body h2 { font-family: var(--f-display); font-size: clamp(1.35rem, 2.4vw, 1.75rem); margin: 0 0 1rem; }
        .oc-collection-copy__body h3 { font-size: 1.02rem; font-weight: 600; margin: 1.75rem 0 0.5rem; }
        .oc-collection-copy__body p { color: var(--c-ink-soft); line-height: 1.7; margin: 0 0 1rem; }
        .oc-collection-copy__body a { color: var(--c-gold-text); text-decoration: underline; text-underline-offset: 2px; }
      </style>
      <div class="rte oc-collection-copy__body">{{ oc_seo }}</div>
    </div>
  </section>
{%- endif -%}

{%- capture oc_collection_schema -%}
{
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  "name": {{ collection.title | json }},
  "url": "{{ shop.url }}{{ collection.url }}",
  {%- if collection.description != blank -%}
  "description": {{ collection.description | strip_html | json }},
  {%- endif -%}
  {%- if collection.image -%}
  "image": {{ collection.image | image_url: width: 1200 | prepend: "https:" | json }},
  {%- endif -%}
  "mainEntity": {
    "@type": "ItemList",
    "numberOfItems": {{ collection.products_count | default: collection.products.size }},
    "itemListElement": [
      {%- for product in collection.products limit: 12 -%}
      {
        "@type": "ListItem",
        "position": {{ forloop.index }},
        "url": "{{ shop.url }}{{ product.url }}",
        "name": {{ product.title | json }}
      }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  }
}
{%- endcapture -%}
<script type="application/ld+json">{{ oc_collection_schema | strip_newlines | remove: '  ' }}</script>

{% schema %}
{
  "name": "Collection copy & schema",
  "settings": []
}
{% endschema %}
