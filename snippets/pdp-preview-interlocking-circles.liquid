{%- comment -%}
  Interlocking circle / family-names necklace live preview.
  Three interlocked rings; engraving curves along the front ring band.
{%- endcomment -%}
{% style %}
  .ep--interlocking { padding: 16px 12px 10px; }
  .ep--interlocking svg { width: min(100%, 300px); height: auto; display: block; margin: 0 auto; }
  .ep--interlocking .ep__ring-band {
    fill: none;
    stroke-width: 16;
    stroke-linecap: round;
  }
  .ep--interlocking .ep__ring-inner {
    fill: none;
    stroke: rgba(255,255,255,0.14);
    stroke-width: 12;
  }
  .ep--interlocking .ep__engrave-text {
    font-size: 9.5px;
    letter-spacing: 0.12em;
    fill: #2a2a32;
  }
  [data-metal="gold"] .ep--interlocking .ep__engrave-text,
  [data-metal="Gold"] .ep--interlocking .ep__engrave-text,
  [data-metal="rose-gold"] .ep--interlocking .ep__engrave-text {
    fill: #3a2e1a;
  }
  [data-metal="black"] .ep--interlocking .ep__engrave-text,
  [data-metal="Black"] .ep--interlocking .ep__engrave-text {
    fill: #f2e9d6;
  }
{% endstyle %}
<div class="engrave-field">
  <label class="option-group buy-step" style="margin-bottom:8px" for="engrave-input">Your engraving</label>
  <div class="ep ep--interlocking" aria-hidden="true">
    <svg viewBox="0 0 300 180" class="ep__interlock-svg">
      <defs>
        {%- comment -%} Text path = lower arc of the FRONT ring centerline (cx=188, cy=88, rx=62, ry=38) {%- endcomment -%}
        <path id="interlock-text-path" d="M 132,100 A 62,38 0 0 0 244,100" fill="none"/>
      </defs>

      {%- comment -%} Back-left ring {%- endcomment -%}
      <ellipse cx="110" cy="78" rx="62" ry="38" class="ep__ring-band" style="stroke:url(#ep-metal-silver)"/>
      <ellipse cx="110" cy="78" rx="62" ry="38" class="ep__ring-inner"/>

      {%- comment -%} Mid ring {%- endcomment -%}
      <ellipse cx="150" cy="92" rx="62" ry="38" class="ep__ring-band" style="stroke:url(#ep-metal-silver)"/>
      <ellipse cx="150" cy="92" rx="62" ry="38" class="ep__ring-inner"/>

      {%- comment -%} Front-right ring (engraved) {%- endcomment -%}
      <ellipse cx="188" cy="88" rx="62" ry="38" class="ep__ring-band" style="stroke:url(#ep-metal-silver)"/>
      <ellipse cx="188" cy="88" rx="62" ry="38" class="ep__ring-inner"/>

      <text class="ep__engrave-text ep__engrave-text--curve" text-anchor="middle">
        <textPath href="#interlock-text-path" startOffset="50%"
                  data-engrave-preview
                  data-fit="140" data-fit-chars="16" lengthAdjust="spacingAndGlyphs"
                  data-placeholder="{{ engraving_placeholder | default: 'Names & dates' | escape }}">{{ engraving_placeholder | default: 'Names & dates' }}</textPath>
      </text>
    </svg>
    <p class="ep__hint">Live preview — text curves along the front ring</p>
  </div>
  <input type="text" id="engrave-input" data-engrave-input
         name="properties[Engraving]"
         maxlength="{{ engraving_max }}"
         placeholder="{{ engraving_placeholder | default: 'Matthew · Proverbs 3:5' | escape }}"
         {% if engraving_required %}required{% endif %}
         autocomplete="off">
  <p class="engrave-help">Add names, a short message, or a date — we engrave exactly what you type along the rings.</p>
  <div class="field-row">
    <span></span>
    <span data-engrave-count>0 / {{ engraving_max }}</span>
  </div>
</div>
