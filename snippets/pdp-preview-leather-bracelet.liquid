{% style %}
  .ep--leather-bracelet { padding:18px 16px 12px; }
  .ep--leather-bracelet svg { display:block; width:min(320px, 100%); height:auto; margin:0 auto; }
  .ep--leather-bracelet .leather-strap { fill:#d8d1c4; stroke:#b8afa0; stroke-width:1.2; }
  .ep--leather-bracelet .leather-strap-edge { fill:none; stroke:rgba(76,56,40,.34); stroke-width:1; stroke-dasharray:2 3; }
  .ep--leather-bracelet .leather-plate { fill:url(#leather-plate-metal); filter:drop-shadow(0 4px 7px rgba(29,22,15,.2)); }
  .ep--leather-bracelet .leather-plate-rim { fill:none; stroke:rgba(255,255,255,.52); stroke-width:1; }
  .ep--leather-bracelet .ep__engrave-text { fill:#332a20; font-size:12px; font-weight:650; letter-spacing:.12em; }
  .ep--leather-bracelet [data-leather-preview="1"],
  .ep--leather-bracelet [data-leather-preview="2"] { font-size:11px; }
  .leather-engraving-fields { display:grid; grid-template-columns:1fr 1fr; gap:10px 12px; margin-top:12px; }
  .leather-engraving-field label { display:flex; justify-content:space-between; gap:8px; margin-bottom:5px; font-size:.78rem; font-weight:600; }
  .leather-engraving-field label span { color:var(--c-ink-soft); font-size:.7rem; font-weight:400; white-space:nowrap; }
  .leather-engraving-help { grid-column:1 / -1; margin:0; color:var(--c-ink-soft); font-size:.76rem; line-height:1.45; }
  @media (max-width:520px) { .leather-engraving-fields { grid-template-columns:1fr; } }
{% endstyle %}

<div class="engrave-field" data-leather-bracelet-engraving>
  <p class="option-group buy-step" style="margin-bottom:8px">Your engraving</p>

  <div class="ep ep--leather-bracelet" aria-label="Live preview of four horizontal engraving placements">
    <svg viewBox="0 0 320 260" role="img" aria-labelledby="leather-preview-title leather-preview-desc">
      <title id="leather-preview-title">Leather bracelet engraving preview</title>
      <desc id="leather-preview-desc">Two engraved lines on the top square plate, one line on the middle bar, and one line on the bottom bar.</desc>
      <defs>
        <linearGradient id="leather-plate-metal" x1="0" y1="0" x2="1" y2="1">
          <stop offset="0" stop-color="#f1dfb5"/>
          <stop offset=".46" stop-color="#c9a968"/>
          <stop offset="1" stop-color="#9d7b43"/>
        </linearGradient>
      </defs>

      <path class="leather-strap" d="M110 8 H210 C227 8 240 21 240 38 V222 C240 239 227 252 210 252 H110 C93 252 80 239 80 222 V38 C80 21 93 8 110 8 Z"/>
      <path class="leather-strap-edge" d="M99 13 V247 M221 13 V247"/>

      <g data-plate="square">
        <rect class="leather-plate" x="101" y="34" width="118" height="82" rx="4"/>
        <rect class="leather-plate-rim" x="106" y="39" width="108" height="72" rx="2"/>
        <text x="160" y="69" text-anchor="middle" class="ep__engrave-text"
              data-leather-preview="1" data-placeholder="27.76N">27.76N</text>
        <text x="160" y="94" text-anchor="middle" class="ep__engrave-text"
              data-leather-preview="2" data-placeholder="82.64W">82.64W</text>
      </g>

      <g data-plate="middle">
        <rect class="leather-plate" x="94" y="139" width="132" height="31" rx="4"/>
        <rect class="leather-plate-rim" x="99" y="144" width="122" height="21" rx="2"/>
        <text x="160" y="159" text-anchor="middle" class="ep__engrave-text"
              data-leather-preview="3" data-placeholder="ALWAYS">ALWAYS</text>
      </g>

      <g data-plate="bottom">
        <rect class="leather-plate" x="94" y="191" width="132" height="31" rx="4"/>
        <rect class="leather-plate-rim" x="99" y="196" width="122" height="21" rx="2"/>
        <text x="160" y="211" text-anchor="middle" class="ep__engrave-text"
              data-leather-preview="4" data-placeholder="ANGEL">ANGEL</text>
      </g>
    </svg>
    <p class="ep__hint">Four horizontal placements — six characters per line</p>
  </div>

  <div class="leather-engraving-fields">
    <div class="leather-engraving-field">
      <label for="leather-engrave-1">Square · Line 1 <span data-leather-count="1">0 / 6</span></label>
      <input type="text" id="leather-engrave-1" data-engrave-input data-leather-input="1"
             name="properties[Engraving — Square Line 1]" maxlength="6"
             placeholder="e.g. 27.76N" {% if engraving_required %}required{% endif %} autocomplete="off">
    </div>
    <div class="leather-engraving-field">
      <label for="leather-engrave-2">Square · Line 2 <span data-leather-count="2">0 / 6 · optional</span></label>
      <input type="text" id="leather-engrave-2" data-leather-input="2"
             name="properties[Engraving — Square Line 2]" maxlength="6"
             placeholder="e.g. 82.64W" autocomplete="off">
    </div>
    <div class="leather-engraving-field">
      <label for="leather-engrave-3">Middle bar <span data-leather-count="3">0 / 6 · optional</span></label>
      <input type="text" id="leather-engrave-3" data-leather-input="3"
             name="properties[Engraving — Middle Bar]" maxlength="6"
             placeholder="e.g. ALWAYS" autocomplete="off">
    </div>
    <div class="leather-engraving-field">
      <label for="leather-engrave-4">Bottom bar <span data-leather-count="4">0 / 6 · optional</span></label>
      <input type="text" id="leather-engrave-4" data-leather-input="4"
             name="properties[Engraving — Bottom Bar]" maxlength="6"
             placeholder="e.g. ANGEL" autocomplete="off">
    </div>
    <p class="leather-engraving-help">Enter exactly what should appear on each plate. Each horizontal line is limited to six characters, including spaces and symbols.</p>
  </div>

  <input type="hidden" data-prop-latlng name="properties[_Exact Decimal Coordinates]">
  <input type="hidden" data-prop-place name="properties[_Place Searched]">
  <input type="hidden" data-prop-maplink name="properties[_Verify on Map]">
  <div class="field-row">
    <button type="button" class="find-coords" data-locator-open>Find my coordinates →</button>
    <span>Fills the two square lines</span>
  </div>
</div>
