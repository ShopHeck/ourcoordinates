{%- comment -%}
  Renders a product card.
  Accepts: card_product, image_loading (optional), image_fetchpriority (optional).
{%- endcomment -%}
{%- liquid
  assign resolved_image_loading = image_loading | default: 'lazy'
  assign resolved_image_priority = image_fetchpriority | default: 'auto'
-%}
<a class="product-card" href="{{ card_product.url }}">
  <div class="product-card__media">
    {%- if card_product.featured_image != blank -%}
      <img src="{{ card_product.featured_image | image_url: width: 480 }}"
           srcset="{{ card_product.featured_image | image_url: width: 320 }} 320w, {{ card_product.featured_image | image_url: width: 480 }} 480w, {{ card_product.featured_image | image_url: width: 600 }} 600w"
           sizes="(max-width: 600px) calc((100vw - 44px) / 2), (max-width: 1100px) 30vw, 280px"
           alt="{{ card_product.featured_image.alt | default: card_product.title | escape }}"
           loading="{{ resolved_image_loading }}" fetchpriority="{{ resolved_image_priority }}" decoding="async" width="600" height="600">
    {%- endif -%}
    <span class="product-card__corners" aria-hidden="true"></span>
    {%- if card_product.available == false -%}
      <span class="product-card__badge">Back soon</span>
    {%- elsif card_product.compare_at_price > card_product.price -%}
      <span class="product-card__badge product-card__badge--sale">Save {{ card_product.compare_at_price | minus: card_product.price | times: 100 | divided_by: card_product.compare_at_price }}%</span>
    {%- else -%}
      {%- comment -%}
        Sets are the AOV driver — flag them in every grid. A product is a
        set when its title says so (" … Set", "Set of 2") or it carries a
        set/bundle tag. Availability and sale badges still win the slot.
      {%- endcomment -%}
      {%- liquid
        assign title_probe = card_product.title | downcase | prepend: ' ' | append: ' '
        assign is_set = false
        if title_probe contains ' set ' or title_probe contains ' sets '
          assign is_set = true
        else
          for tag in card_product.tags
            assign tag_down = tag | downcase | strip
            if tag_down == 'set' or tag_down == 'bundle' or tag_down == 'matching-set'
              assign is_set = true
              break
            endif
          endfor
        endif
      -%}
      {%- if is_set -%}
        <span class="product-card__badge product-card__badge--set">Matching set</span>
      {%- endif -%}
    {%- endif -%}
  </div>
  <p class="product-card__title">{{ card_product.title }}</p>
  <p class="product-card__price">
    {{ card_product.price | money }}
    {%- if card_product.compare_at_price > card_product.price -%}
      <s>{{ card_product.compare_at_price | money }}</s>
    {%- endif -%}
  </p>
  {%- if settings.card_note != blank -%}
    {%- assign card_tags = card_product.tags | join: ',' | downcase -%}
    {%- unless card_tags contains 'no-personalization' or card_product.template_suffix == 'non-custom' or card_product.handle == 'premium-gift-packaging' or card_product.handle == 'routeins' -%}
      <p class="product-card__note">{{ settings.card_note }}</p>
    {%- endunless -%}
  {%- endif -%}
</a>
